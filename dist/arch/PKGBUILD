# Maintainer: Ian Bradley <crabapp@softsrv.net>
_package="WWW::cgit"
pkgname="perl-${_package//::/-}-git"
pkgname="${pkgname,,*}"
pkgver=0.0.1.r22.g728bb88
_dist="${pkgname#perl-}-${pkgver/%.r*/}"
pkgrel=1
pkgdesc="Launcher and instance manager for cgit."
arch=(any)
license=('Artistic-1.0-Perl' 'GPL-1.0-or-later')
depends=('perl' 'perl-frame' 'perl-ipc-nosh'
    'perl-devel-checkbin' 'perl-object-pad')
makedepends=('perl-module-build-tiny' 'perl-app-fatpack' 'cpanminus')
options=('!emptydirs' 'staticlibs')
url="http://github.com/marlencrabapple/WWW-cgit.git#commit=$_commit"
_commit=e8ba781bbf84b016d82bd7b1fe352eaed7be91c6
source=("git+$url#commit=$_commit")
sha512sums=('d5c4ee427d88a3b218493fe7d83e6679bf2401e7c8635af9a890cb33d6a652b904df530757c25b57ff317b3430cd94bdf62ed7636ff2809e31e05711d3dc2807')
b2sums=('5b2ab70c620f9e1a567eb11e2a8380ef59cea44534b5f1cc8409ee939c8c84cf0c9f6ea7c6910c6f3887f4eff45073f8bdc1a7caaf601a2b3afffcb97641d1ee')

pkgver() {
    cd "$srcdir/$_dist"
    (
        set -o pipefail
        git describe --long --abbrev=7 2>/dev/null | sed 's/\([^-]*-g\)/r\1/;s/-/./g' ||
            printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
    )
}

prepare() {
    cd "$srcdir/$_pkgname"

    unset PERL5LIB PERL_MM_OPT PERL_MB_OPT PERL_LOCAL_LIB_ROOT

    export PERL5LIB="$(pwd)/local/lib/perl5"
    export PERL_CPANM_OPT="-L$(pwd)/local \
   --with-develop \
   --with-configure"
}

build() {
    cd "$srcdir/$_pkgname"
    cpanm --installdeps .
    perl Build.PL
    ./Build build

    mkdir fat

    for pl in $(perl -Mv5.40 -e 'grep { open my $fh q{<}, $_; my $txt = do { local $/; $fh; }; close $fh;  $txt =~ qr$#!/usr/bin/.+perl$ } (@_)' script/*); do
        basename="$(basename "$pl")"
        fatpack pack "$pl" >"fat/$basename-fat.pl"
    done
}

check() {
    cd "$srcdir/$_pkgname"
    ./Build testall
}

package() {
    cd "$srcdir/$_pkgname"
    ./Build install \
        --destdir="$pkgdir" \
        --install_base=/usr \
        --prefix=/usr \
        --verbose
}
