 listen = 'sock://./run/cgit.sock'
 execdir = '/bs/www/WWW-cgit/'
 serve-static = 1 # Will add middleware to serve static content
 mode = "development"
 server = "Frame::Server"

[[middleware]]
 name = "Plack::Middleware::ReverseProxy"
 enable_if = "!$env->{REMOTE_ADDR}"

[ssl]
 enable = 1
 server_auth = 1
 certfile = ""
 keyfile = ""

